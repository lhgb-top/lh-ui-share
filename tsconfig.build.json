{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // 发布的声明文件不得继承 vite/client 的环境类型（vite 不在 dependencies 里）：
    // src/ 目前零处使用 import.meta.env，显式清空 types 防止日后泄漏进 .d.ts
    "types": [],
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    // 开启 sourcemap 映射：各 UI 库编辑器从 es/*.d.ts 可跳回 share 的 src/ 源码
    // （本地联动时尤为关键：alias 到源码后类型仍来自构建产物，映射保证跳转落点一致）
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "es",
    "rootDir": "src"
  },
  "include": ["src/**/*"],
  "exclude": ["tests"]
}
